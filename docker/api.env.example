# =============================================================================
# api.env.example — 后端容器环境变量模板
#
# 服务器上放在 /opt/luna-blog/api.env（权限 600，属主 deploy），
# 由 deploy/docker-compose.yml 的 api 服务 env_file 读取。
#
# 与 blog-server/.env 的区别：
#   * DB_HOST 不用写（compose 里已固定为 db）
#   * UPLOAD_DIR 不用写（compose 里固定为 /data/uploads）
#   * 其余键与 blog-server/.env 完全一致
# =============================================================================

# development / production（容器里固定 production）
NODE_ENV=production
PORT=3000

# 站点对外地址（RSS / 邮件里的绝对链接）
SITE_URL=http://43.143.72.12

# 允许跨域的前端地址，逗号分隔（同域部署时留空也不会出错）
CORS_ORIGINS=http://43.143.72.12

# ===== 数据库（密码由 compose.env 注入，这里保持一致即可）=====
DB_NAME=luna_blog
DB_USER=luna_blog
DB_PASSWORD=__CHANGE_ME__

# ===== 鉴权（必填，至少 16 位随机字符）=====
JWT_SECRET=__CHANGE_ME_32_BYTES__
JWT_EXPIRES_IN=7d

# ===== 初始管理员（仅 db:init 用；已有库可留空）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== 上传限制（MB）=====
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_FILE_MB=10

# ===== 访问统计 =====
# 访问记录保留天数：默认 90。导入过历史访问数据时调大（如 3650），
# 否则历史记录会被清理策略删除（表现为「总访问量突然归零」）。
VISIT_RETENTION_DAYS=3650
