# =============================================================================
# luna-blog.service — Luna Blog 后端（Koa 3 + Sequelize 6）
#
# 安装位置：/etc/systemd/system/luna-blog.service
# 安装/更新：
#   sudo cp deploy/systemd/luna-blog.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now luna-blog
#
# 说明：
#   * 以非特权系统用户 luna-blog 运行；代码只读，只有 uploads 目录可写。
#   * UPLOAD_DIR 必须与 ReadWritePaths 完全一致，否则上传会 EROFS/EACCES。
#   * 应用通过 dotenv 自行读取 blog-server/.env（该文件对 luna-blog 可读）。
#   * 本文件应与线上 `systemctl cat luna-blog` 的输出保持一致。
# =============================================================================
[Unit]
Description=Luna Blog Backend (Koa + Sequelize)
Documentation=https://github.com/FurinaLuna/luna-blog
After=network-online.target mysql.service
Wants=network-online.target mysql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=luna-blog
Group=luna-blog
WorkingDirectory=/var/www/luna-blog/src/blog-server

Environment=NODE_ENV=production
Environment=UPLOAD_DIR=/var/www/luna-blog/data/uploads

ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# 日志统一进 journald（journalctl -u luna-blog）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=luna-blog-api

# 安全加固：整个文件系统只读，仅 uploads 可写
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/www/luna-blog/data/uploads

MemoryMax=768M

[Install]
WantedBy=multi-user.target
