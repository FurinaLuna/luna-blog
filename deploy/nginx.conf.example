# Luna Blog 生产环境 Nginx 配置样例
# 替换：your-domain.com、/var/www/luna-blog、上传目录、证书路径

upstream luna_blog_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name your-domain.com;
    # 证书就绪后取消注释并改用 443
    # return 301 https://$host$request_uri;

    client_max_body_size 10m;   # 与 UPLOAD_MAX_FILE_MB 保持一致

    charset utf-8;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml text/xml application/xml;

    # ---------- 前台（history 路由，必须回退 index.html）----------
    root /var/www/luna-blog/blog-web/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- 后台（以 /admin/ 子路径部署时使用）----------
    # 构建：pnpm -C blog-admin build --base=/admin/
    location /admin/ {
        alias /var/www/luna-blog/blog-admin/dist/;
        try_files $uri $uri/ /admin/index.html;
    }

    # ---------- 静态资源缓存 ----------
    location ~* ^/assets/.+\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---------- API ----------
    location /api/ {
        proxy_pass http://luna_blog_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # ---------- 上传文件（生产建议指向持久化目录，或托管到对象存储）----------
    location /uploads/ {
        proxy_pass http://luna_blog_api;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public";
    }

    # ---------- RSS ----------
    location = /rss.xml {
        proxy_pass http://luna_blog_api;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=600";
    }

    # ---------- 安全头 ----------
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
