# ===== 运行环境 =====
# development / production
NODE_ENV=development
# 后端监听端口
PORT=3000
# 前端站点地址（用于 RSS / 邮件里的绝对链接）
SITE_URL=http://localhost:5173
# 允许跨域的前端地址，逗号分隔；生产环境填真实域名
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===== 数据库（必填，缺失将拒绝启动）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=luna_blog
DB_USER=root
DB_PASSWORD=

# ===== 鉴权（必填，至少 16 位随机字符串）=====
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== 初始化管理员（仅 db:init 使用，至少 8 位）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== 上传 =====
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_FILE_MB=10
